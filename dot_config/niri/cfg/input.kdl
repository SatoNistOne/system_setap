// Клавиатура, тачпад, мышь

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
    }

    touchpad {
        tap                 // касание = клик
        natural-scroll      // прокрутка «как на телефоне»
        dwt                 // тачпад выключен, пока печатаешь
    }

    // Фокус за курсором, но лента не прокручивается сама,
    // если курсор задел край соседнего окна.
    focus-follows-mouse max-scroll-amount="0%"

    // При переходе клавишами на другое окно/монитор курсор прыгает туда.
    warp-mouse-to-focus
}
