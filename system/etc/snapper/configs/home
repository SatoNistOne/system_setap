# Snapper "home" (decisions §4): one snapshot a day, keep 7. The timeline
# timer runs daily (snapper-timeline.timer.d/daily.conf), not hourly.
# Nested subvolumes ~/.cache and ~/.local/share/Steam are not included.
SUBVOLUME="/home"
FSTYPE="btrfs"
QGROUP=""
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="no"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="0"
TIMELINE_LIMIT_HOURLY="0"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
